# Non-secret manifest for the installed release-mac-app helper. CI uses repo scripts.
MAC_RELEASE_APP_NAME=today-md
MAC_RELEASE_REPO=arthurliebhardt/today-md
MAC_RELEASE_BUNDLE_ID=com.today-md.app
MAC_RELEASE_VERSION_FILE=/dev/null
MARKETING_VERSION=$(python3 apps/macos/scripts/release-metadata.py project-version --short)
BUILD_NUMBER=$(python3 apps/macos/scripts/release-metadata.py project-version --build)
MAC_RELEASE_APPCAST=dist/macos/appcast.xml
MAC_RELEASE_FEED_URL=https://github.com/arthurliebhardt/today-md/releases/latest/download/appcast.xml
MAC_RELEASE_DOWNLOAD_URL_PREFIX='https://github.com/arthurliebhardt/today-md/releases/download/v${MARKETING_VERSION}/'
MAC_RELEASE_APP_ZIP='dist/macos/today-md-v${MARKETING_VERSION}-macos.zip'
MAC_RELEASE_DSYM_ZIP='dist/macos/today-md-v${MARKETING_VERSION}-macos.dSYM.zip'
MAC_RELEASE_INFO_PLIST=dist/macos/export/today-md.app/Contents/Info.plist
MAC_RELEASE_SUPUBLIC_ED_KEY=${SPARKLE_PUBLIC_ED_KEY:-}
MAC_RELEASE_PACKAGE_CMD='RELEASE_TAG="$TAG" bash apps/macos/scripts/release-macos.sh'
MAC_RELEASE_SPARKLE_ACCOUNT=today-md
MAC_RELEASE_GENERATE_APPCAST_ARGS='--maximum-deltas 0'
MAC_RELEASE_EXTRA_ASSET_PATTERNS='appcast.xml release.json SHA256SUMS'
